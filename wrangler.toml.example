# Pages deployment example. Copy to `wrangler.toml` only after replacing IDs.
name = "navix"
compatibility_date = "2026-01-01"
pages_build_output_dir = "dist"

[[kv_namespaces]]
binding = "NAVIX_KV"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[[r2_buckets]]
binding = "NAVIX_BACKUPS"
bucket_name = "REPLACE_WITH_R2_BUCKET_NAME"
